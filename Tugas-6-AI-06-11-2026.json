      "parameters": {
        "jsCode": "const employeeData = $input.first().json;\nconst formData = $('On form submission').first().json;\n\n// Hitung durasi (Luxon)\nconst start = DateTime.fromISO(formData['Tanggal Mulai']);\nconst end = DateTime.fromISO(formData['Tanggal Selesai']);\nconst durationInDays = end.diff(start, 'days').days + 1;\n\n// Validasi Saldo\nconst currentBalance = parseInt(employeeData.Saldo_Cuti) || 0;\nconst isApprovedSystem = currentBalance >= durationInDays;\n\n// Buat ID Request\nconst requestId = 'REQ-' + DateTime.now().toFormat('yyyyMMddHHmmss');\n\nreturn [{\n  json: {\n    ...employeeData,\n    ...formData,\n    durationRequested: durationInDays,\n    isApprovedSystem: isApprovedSystem,\n    requestId: requestId,\n    Manager_Email: employeeData.Manager_Email\n  }\n}];"
      },
