        "jsCode": "for (const item of $input.all()) {\n  const candidate = item.json;\n  const role = candidate.position || \"Software Engineer\";\n  const skills = candidate.claimed_skills;\n  const background = candidate.past_company_type;\n\n  const systemPrompt = `Role: You are a Senior Technical Interviewer for a ${role} position.\nYour goal is to validate the technical depth of a candidate named ${candidate.candidate_name}.\n\nCandidate Profile:\n- Claimed Skills: ${skills}\n- Past Company Type: ${background}\n\nOUTPUT FORMAT (Markdown):\n1. **Topik**: [Nama Topik]\n- **Pertanyaan**: [Studi Kasus Spesifik]\n- **Ekspektasi Jawaban Senior**: [Poin Kunci]`;\n\n  item.json.llm_prompt = systemPrompt;\n}\nreturn $input.all();"
