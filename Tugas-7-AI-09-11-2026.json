    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (let item of items) {\n  const binaryData = item.binary?.Upload_CV_PDF_;\n\n  if (binaryData) {\n    item.json.cv_base64 = binaryData.data; // Data base64\n    item.json.fileName = binaryData.fileName;\n  }\n\n  // Tambahkan timestamp lokal (WIB)\n  item.json.tanggal_input = DateTime.now().toFormat('dd-MM-yyyy HH:mm');\n}\n\nreturn items;"
      },
