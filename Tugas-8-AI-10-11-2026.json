    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const feedback = item.json.feedback || \"\";\n  \n  // Bangun prompt untuk setiap baris\n  const prompt = `Analyze this employee feedback in Indonesian: \"${feedback}\"\n  \nTasks:\n1. Determine sentiment (POSITIVE, NEUTRAL, NEGATIVE).\n2. Categorize the issue (Facilities, Management, Salary, Workload, Training, Other).\n3. Suggest a quick action (max 5 words).\n\nYou must output ONLY valid JSON in this format:\n{ \"sentiment\": \"...\", \"category\": \"...\", \"action_plan\": \"...\" }`;\n\n  results.push({\n    json: {\n      employee_id: item.json.employee_id,\n      feedback: feedback,\n      prompt: prompt\n    }\n  });\n}\n\nreturn results;"
      },
